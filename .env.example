# -------------------------------------------------------------
# Codyssey B7-1 환경 변수 템플릿 (.env.example)
# 실제 배포/실행 시 이 파일을 복사하여 .env 로 이름을 변경한 뒤 사용하세요.
# -------------------------------------------------------------

# [기본 애플리케이션 설정]
PROJECT_NAME="Codyssey B7-1 AI Chatbot"
DEBUG=True

# [데이터베이스 설정 - SQLite]
DATABASE_URL="sqlite:///./chat_service.db"

# [보안 및 인증 설정 - 신재은 담당]
SECRET_KEY="temporary-secret-key-for-development-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# [AI 챗봇 설정 - 조명환 담당]
AI_API_KEY="your-actual-api-key-here"
AI_MODEL_NAME="gpt-4o-mini"
AI_TIMEOUT_SECONDS=10.0

# [대화 로그 조회 설정 - 권태현 담당]
# 비워 두면 GET /api/logs/admin(전체 대화 로그 조회)이 꺼집니다.
# 쓰려면 추측하기 어려운 긴 문자열로 정하고, 요청 헤더 X-Admin-Key에 같은 값을 보내세요.
ADMIN_API_KEY=""
