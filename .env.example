# -------------------------------------------------------------
# Codyssey B7-1 환경 변수 템플릿 (.env.example)
# 실제 배포/실행 시 이 파일을 복사하여 .env 로 이름을 변경한 뒤 사용하세요.
# -------------------------------------------------------------

# [기본 애플리케이션 설정]
PROJECT_NAME="Codyssey B7-1 AI Chatbot"
DEBUG=True

# [데이터베이스 설정 - SQLite]
DATABASE_URL="sqlite:///./chat_service.db"

# [보안 및 인증 설정 - 신재은 담당]
SECRET_KEY="temporary-secret-key-for-development-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# [AI 챗봇 설정 - 조명환 담당]
AI_API_KEY="your-actual-api-key-here"
# 코디세이 AI 콘솔 등 커스텀 프록시를 사용하는 경우 Base URL을 입력하세요 (비워두면 OpenAI/Gemini 공식 엔드포인트 사용)
AI_BASE_URL=""
AI_MODEL_NAME="gpt-4o-mini"
AI_TIMEOUT_SECONDS=10.0

# [관리자 계정 - 권태현 담당]
# 서버가 시작할 때 아래 아이디를 관리자 계정으로 준비합니다. (없으면 만들고, 있으면 관리자 역할과 비밀번호를 아래 값으로 맞춤)
# 관리자는 모든 사용자의 대화를 볼 수 있으니, 외부에 공개한 서버에서는 비밀번호를 바꾸세요. 비밀번호를 비우면 자동 준비를 하지 않습니다.
# 다른 가입 아이디를 관리자로 지정: python scripts/create_admin.py <아이디>
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="1234"
